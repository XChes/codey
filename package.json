{
  "name": "desktop-agent-skeleton",
  "version": "0.1.0",
  "private": true,
  "description": "A reusable macOS Electron foundation for a local coding agent.",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "predev": "pnpm prepare:gh && pnpm build:agent-host",
    "dev": "electron-vite dev",
    "prestart": "pnpm prepare:gh && pnpm build:agent-host",
    "start": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src test scripts electron.vite.config.ts vite.agent-host.config.ts vitest.config.ts vitest.agent-host.config.ts",
    "test": "vitest run",
    "test:agent-host": "vitest run --config vitest.agent-host.config.ts",
    "build": "electron-vite build && pnpm build:agent-host",
    "build:agent-host": "vite build --config vite.agent-host.config.ts",
    "prepare:gh": "node scripts/prepare-gh.mjs arm64",
    "verify:packaged-gh": "test -x \"dist/mac-arm64/Desktop Agent.app/Contents/Resources/bin/gh\" && test -f \"dist/mac-arm64/Desktop Agent.app/Contents/Resources/licenses/github-cli-LICENSE.txt\" && \"dist/mac-arm64/Desktop Agent.app/Contents/Resources/bin/gh\" --version",
    "package": "pnpm build && pnpm prepare:gh && NODE_USE_SYSTEM_CA=1 electron-builder --mac dir && pnpm verify:packaged-gh",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.58",
    "@anthropic-ai/sandbox-runtime": "0.0.73",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@pierre/diffs": "^1.3.5",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-virtual": "^3.14.9",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "minimatch": "^10.2.6",
    "prism-react-renderer": "^2.4.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
